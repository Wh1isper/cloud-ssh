{
  "$id": "https://owlmux.dev/contracts/public/v1/control.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AuditEventSummary": {
      "additionalProperties": false,
      "properties": {
        "action": { "maxLength": 64, "minLength": 1, "type": "string" },
        "audit_event_id": { "format": "uuid", "type": "string" },
        "machine_id": { "format": "uuid", "type": "string" },
        "occurred_at": { "format": "date-time", "type": "string" },
        "outcome_class": { "enum": ["success", "rejected", "ambiguous"] },
        "resource_kind": { "enum": ["deployment", "ssh_credential", "machine", "enrollment", "relay_binding", "machine_owner", "server_node"] },
        "ssh_credential_id": { "format": "uuid", "type": "string" }
      },
      "required": ["action", "audit_event_id", "occurred_at", "outcome_class", "resource_kind"], "type": "object"
    },
    "CreateCredentialInput": {
      "additionalProperties": false,
      "properties": { "name": { "maxLength": 64, "minLength": 1, "type": "string" } },
      "required": ["name"], "type": "object"
    },
    "CreateMachineInput": {
      "additionalProperties": false,
      "properties": {
        "alias": { "maxLength": 64, "minLength": 1, "type": "string" },
        "ssh_credential_id": { "format": "uuid", "type": "string" },
        "target_account": { "maxLength": 64, "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$", "type": "string" },
        "tmux_path": { "maxLength": 256, "minLength": 1, "type": "string" },
        "tmux_socket_identity": { "maxLength": 128, "minLength": 1, "type": "string" }
      },
      "required": ["alias", "target_account", "tmux_path", "tmux_socket_identity"], "type": "object"
    },
    "CredentialSummary": {
      "additionalProperties": false,
      "properties": {
        "bound_machine_count": { "minimum": 0, "type": "integer" },
        "is_default": { "type": "boolean" },
        "name": { "type": "string" },
        "public_fingerprint_sha256": { "type": "string" },
        "public_key": { "type": "string" },
        "ssh_credential_id": { "format": "uuid", "type": "string" },
        "status": { "enum": ["active", "retired"] }
      },
      "required": ["bound_machine_count", "is_default", "name", "public_fingerprint_sha256", "public_key", "ssh_credential_id", "status"], "type": "object"
    },
    "DeploymentPresentation": {
      "additionalProperties": false,
      "properties": {
        "config_epoch": { "minimum": 1, "type": "integer" },
        "default_ssh_credential_id": { "format": "uuid", "type": "string" },
        "deployment_id": { "format": "uuid", "type": "string" },
        "profile": { "enum": ["single_node", "clustered"] },
        "server_build_id": { "type": "string" }
      },
      "required": ["config_epoch", "default_ssh_credential_id", "deployment_id", "profile", "server_build_id"], "type": "object"
    },
    "EnrollmentTokenResponse": {
      "additionalProperties": false,
      "properties": {
        "enrollment_expires_in": { "maximum": 900, "minimum": 1, "type": "integer" },
        "enrollment_token": { "type": "string" }
      },
      "required": ["enrollment_expires_in", "enrollment_token"], "type": "object"
    },
    "MachineAliasInput": {
      "additionalProperties": false,
      "properties": { "alias": { "maxLength": 64, "minLength": 1, "type": "string" } },
      "required": ["alias"], "type": "object"
    },
    "MachineCreated": {
      "additionalProperties": false,
      "properties": {
        "enrollment_expires_in": { "maximum": 900, "minimum": 1, "type": "integer" },
        "enrollment_token": { "type": "string" },
        "machine": { "$ref": "#/$defs/MachineSummary" }
      },
      "required": ["enrollment_expires_in", "enrollment_token", "machine"], "type": "object"
    },
    "MachineCredentialInput": {
      "additionalProperties": false,
      "properties": { "ssh_credential_id": { "format": "uuid", "type": "string" } },
      "required": ["ssh_credential_id"], "type": "object"
    },
    "MetricsSnapshot": {
      "additionalProperties": false,
      "properties": {
        "api_authenticated_requests_total": { "maximum": 9007199254740991, "minimum": 0, "type": "integer" },
        "api_auth_rejections_total": { "maximum": 9007199254740991, "minimum": 0, "type": "integer" },
        "api_mutation_overloads_total": { "maximum": 9007199254740991, "minimum": 0, "type": "integer" },
        "node_ready": { "type": "boolean" },
        "owner_absent_resolutions_total": { "maximum": 9007199254740991, "minimum": 0, "type": "integer" },
        "owner_local_resolutions_total": { "maximum": 9007199254740991, "minimum": 0, "type": "integer" },
        "owner_remote_resolutions_total": { "maximum": 9007199254740991, "minimum": 0, "type": "integer" },
        "owner_resolution_failures_total": { "maximum": 9007199254740991, "minimum": 0, "type": "integer" }
      },
      "required": ["api_authenticated_requests_total", "api_auth_rejections_total", "api_mutation_overloads_total", "node_ready", "owner_absent_resolutions_total", "owner_local_resolutions_total", "owner_remote_resolutions_total", "owner_resolution_failures_total"], "type": "object"
    },
    "MachineDetail": {
      "additionalProperties": false,
      "properties": {
        "alias": { "type": "string" },
        "host_identity": { "maxLength": 2048, "minLength": 32, "pattern": "^ssh-ed25519 ", "type": "string" },
        "lifecycle": { "enum": ["pending", "verifying", "active", "disabled"] },
        "machine_id": { "format": "uuid", "type": "string" },
        "reachability": { "enum": ["unknown", "connecting", "reachable", "temporarily_unavailable", "owner_unreachable"] },
        "ssh_credential_id": { "format": "uuid", "type": "string" },
        "target_account": { "maxLength": 64, "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$", "type": "string" },
        "tmux_path": { "maxLength": 256, "minLength": 1, "type": "string" },
        "tmux_socket_identity": { "maxLength": 128, "minLength": 1, "type": "string" }
      },
      "required": ["alias", "lifecycle", "machine_id", "reachability", "ssh_credential_id", "target_account", "tmux_path", "tmux_socket_identity"], "type": "object"
    },
    "MachineSummary": {
      "additionalProperties": false,
      "properties": {
        "alias": { "type": "string" },
        "lifecycle": { "enum": ["pending", "verifying", "active", "disabled"] },
        "machine_id": { "format": "uuid", "type": "string" },
        "reachability": { "enum": ["unknown", "connecting", "reachable", "temporarily_unavailable", "owner_unreachable"] },
        "ssh_credential_id": { "format": "uuid", "type": "string" }
      },
      "required": ["alias", "lifecycle", "machine_id", "reachability", "ssh_credential_id"], "type": "object"
    }
  },
  "title": "OwlMux control plane v1",
  "type": "object"
}
